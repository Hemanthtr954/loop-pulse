# Copy to .env and adjust. Every variable is optional; defaults are shown.

# Repositories synced on start (comma-separated owner/name, public GitHub repos).
TRACKED_REPOS=fastify/fastify,expressjs/express
# Extra repos that may be added at runtime via POST /v1/repos, or allow any public repo.
ALLOWED_REPOS=pallets/flask
ALLOW_ANY_PUBLIC_REPO=false
MAX_REPOS=20

# History kept locally and refresh cadence.
SYNC_LOOKBACK_DAYS=365
SYNC_INTERVAL_MINUTES=30

# Optional: enables reviewers + flow insights. Fine-grained token, public repositories, read-only.
GITHUB_TOKEN=

# Optional LLM for the narrative. Without a key the deterministic narrator is used.
# LLM_PROVIDER=auto|anthropic|openai|rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional: require x-api-key on POST endpoints.
API_KEY=
# Optional: browser origins allowed to call the API cross-origin (the bundled UI needs none).
CORS_ORIGINS=
LOG_LEVEL=info
